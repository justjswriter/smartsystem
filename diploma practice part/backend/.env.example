# Copy: cp .env.example .env  — paste the Supabase (or other cloud) string from Project Settings → Database.
# The app normalizes postgresql:// and postgres:// to the psycopg2 driver. Never commit a real .env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
SECRET_KEY=change-this-secret-key
DEVICE_API_KEY=change-this-device-api-key
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MOISTURE_MIN=30
TEMPERATURE_MAX=30
HUMIDITY_MIN=35
LIGHT_MIN=25
