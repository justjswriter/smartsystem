APP_NAME=Practice Backend
API_V1_PREFIX=/api/v1

POSTGRES_DB=practice_db
POSTGRES_USER=practice_user
POSTGRES_PASSWORD=change_this_database_password
DATABASE_URL=postgresql+asyncpg://practice_user:change_this_database_password@postgres:5432/practice_db

SECRET_KEY=change_this_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# Replace example.com with your real domain or server IP.
CORS_ORIGINS=["http://example.com","https://example.com"]

LOG_LEVEL=INFO

MOISTURE_MIN=30
TEMPERATURE_MAX=35
HUMIDITY_MIN=30
LIGHT_MIN=200

EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=zaremabazarova11@gmail.com
SMTP_PASSWORD=put_google_app_password_here
SMTP_FROM_EMAIL=zaremabazarova11@gmail.com
SMTP_USE_TLS=true
